/* =========================================
   CAMPUSIQ CINEMATIC UI
   ========================================= */

* {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
}

:root {
    --red: #ff2638;
    --red-dark: #8d0712;
    --blue: #168cff;
    --blue-dark: #061d3d;
    --gold: #ffd34e;
    --cyan: #55eaff;
    --green: #31ff9a;
    --white: #f4f7ff;
    --muted: #8490a7;
    --panel: rgba(10, 14, 25, 0.88);
    --border: rgba(255, 255, 255, 0.10);
}

html {
    scroll-behavior: smooth;
}

body {
    min-height: 100vh;
    background:
        radial-gradient(circle at 50% 0%, rgba(255, 30, 50, 0.13), transparent 35%),
        radial-gradient(circle at 10% 80%, rgba(0, 100, 255, 0.10), transparent 30%),
        #03050a;
    color: var(--white);
    font-family: Arial, Helvetica, sans-serif;
    overflow-x: hidden;
}


/* =========================================
   BACKGROUND
   ========================================= */

.background-grid {
    position: fixed;
    inset: 0;
    z-index: -3;

    background-image:
        linear-gradient(rgba(255,255,255,.025) 1px, transparent 1px),
        linear-gradient(90deg, rgba(255,255,255,.025) 1px, transparent 1px);

    background-size: 45px 45px;

    mask-image: linear-gradient(to bottom, black, transparent);
}

.scan-line {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 2px;
    z-index: 10000;

    background: linear-gradient(
        90deg,
        transparent,
        var(--red),
        var(--gold),
        transparent
    );

    box-shadow: 0 0 20px var(--red);

    animation: scan 6s linear infinite;
    pointer-events: none;
}

@keyframes scan {
    0% {
        transform: translateY(0);
        opacity: 0;
    }

    10% {
        opacity: 1;
    }

    90% {
        opacity: 1;
    }

    100% {
        transform: translateY(100vh);
        opacity: 0;
    }
}


/* =========================================
   LOGIN
   ========================================= */

.login-page {
    position: fixed;
    inset: 0;
    z-index: 9999;

    display: flex;
    justify-content: center;
    align-items: center;

    background:
        radial-gradient(
            circle at center,
            rgba(255, 30, 50, .12),
            transparent 35%
        ),
        #02040a;

    overflow: hidden;

    transition:
        transform .85s cubic-bezier(.77,0,.175,1),
        opacity .5s ease;
}

.login-page.login-slide-out {
    transform: translateX(-100%);
    opacity: 0;
    pointer-events: none;
}


/* Decorative energy rings */

.login-background {
    position: absolute;
    inset: 0;
    pointer-events: none;
}

.energy-ring {
    position: absolute;
    border-radius: 50%;

    border: 1px solid rgba(255, 40, 55, .12);

    left: 50%;
    top: 50%;

    transform: translate(-50%, -50%);
}

.ring-one {
    width: 400px;
    height: 400px;
    animation: rotate 20s linear infinite;
}

.ring-two {
    width: 650px;
    height: 650px;
    border-color: rgba(255, 211, 78, .07);
    animation: rotateReverse 30s linear infinite;
}

.ring-three {
    width: 900px;
    height: 900px;
    border-color: rgba(22, 140, 255, .06);
}

@keyframes rotate {
    from {
        transform: translate(-50%, -50%) rotate(0);
    }

    to {
        transform: translate(-50%, -50%) rotate(360deg);
    }
}

@keyframes rotateReverse {
    from {
        transform: translate(-50%, -50%) rotate(360deg);
    }

    to {
        transform: translate(-50%, -50%) rotate(0);
    }
}


/* =========================================
   SHIELDS
   ========================================= */

.hero-shield {
    position: absolute;

    width: 145px;
    height: 145px;

    border-radius: 50%;

    background:
        radial-gradient(
            circle,
            #f7f7f7 0 12%,
            var(--red) 13% 30%,
            #f4f4f4 31% 47%,
            #bd101d 48% 70%,
            #eeeeee 71% 76%,
            #111 77% 100%
        );

    box-shadow:
        0 0 20px rgba(255, 30, 50, .35),
        inset 0 0 20px rgba(255,255,255,.2);

    animation: shieldFloat 5s ease-in-out infinite;
}

.shield-star {
    position: absolute;

    top: 50%;
    left: 50%;

    transform: translate(-50%, -50%);

    font-size: 42px;
    color: white;

    text-shadow:
        0 0 5px white,
        0 0 15px rgba(255,255,255,.7);
}

.shield-left {
    left: 8%;
    top: 25%;
}

.shield-right {
    right: 8%;
    bottom: 20%;

    animation-delay: -2s;
}

@keyframes shieldFloat {
    0%,100% {
        transform: translateY(0) rotate(-5deg);
    }

    50% {
        transform: translateY(-20px) rotate(5deg);
    }
}


/* =========================================
   THOR HAMMER
   ========================================= */

.thor-hammer {
    position: absolute;

    right: 13%;
    top: 16%;

    width: 130px;
    height: 170px;

    transform: rotate(-25deg);

    animation: hammerFloat 5s ease-in-out infinite;
}

.hammer-head {
    position: absolute;

    width: 120px;
    height: 70px;

    top: 0;
    left: 0;

    border-radius: 12px;

    background:
        linear-gradient(
            135deg,
            #e9f3ff,
            #657083,
            #dbe6f4
        );

    border: 2px solid #aab5c5;

    box-shadow:
        0 0 15px rgba(150,190,255,.4),
        inset 0 0 20px rgba(255,255,255,.3);
}

.hammer-head::after {
    content: "";
    position: absolute;

    width: 15px;
    height: 100%;

    right: 12px;
    top: 0;

    background: rgba(255,255,255,.15);
}

.hammer-handle {
    position: absolute;

    width: 27px;
    height: 115px;

    left: 47px;
    top: 55px;

    border-radius: 5px;

    background:
        linear-gradient(
            90deg,
            #4b2a17,
            #a86737,
            #3b1c0d
        );

    box-shadow: 0 0 8px rgba(255,180,80,.2);
}

@keyframes hammerFloat {
    0%,100% {
        transform: rotate(-25deg) translateY(0);
    }

    50% {
        transform: rotate(-18deg) translateY(-18px);
    }
}


/* =========================================
   REACTOR
   ========================================= */

.reactor {
    position: absolute;

    width: 170px;
    height: 170px;

    left: 12%;
    bottom: 15%;

    border-radius: 50%;

    border: 4px solid rgba(90, 230, 255, .5);

    box-shadow:
        0 0 20px rgba(80,220,255,.3),
        inset 0 0 30px rgba(80,220,255,.2);

    animation: reactorPulse 2s ease-in-out infinite;
}

.reactor-core {
    position: absolute;

    width: 65px;
    height: 65px;

    top: 50%;
    left: 50%;

    transform: translate(-50%, -50%);

    border-radius: 50%;

    background: radial-gradient(
        circle,
        white,
        var(--cyan) 35%,
        #008fb0 65%,
        transparent 70%
    );

    box-shadow:
        0 0 25px var(--cyan),
        0 0 70px rgba(80,220,255,.7);
}

.reactor-ring {
    position: absolute;

    inset: 18px;

    border-radius: 50%;

    border: 2px dashed rgba(85,234,255,.7);

    animation: rotate 8s linear infinite;
}

.reactor-ring-two {
    inset: 35px;
    animation-direction: reverse;
    animation-duration: 5s;
}

@keyframes reactorPulse {
    50% {
        box-shadow:
            0 0 50px rgba(80,220,255,.6),
            inset 0 0 40px rgba(80,220,255,.4);
    }
}


/* =========================================
   LOGIN CARD
   ========================================= */

.login-card {
    position: relative;
    z-index: 5;

    width: min(470px, 92%);

    padding: 42px;

    border: 1px solid rgba(255, 255, 255, .12);

    background:
        linear-gradient(
            145deg,
            rgba(15,18,29,.96),
            rgba(4,6,12,.94)
        );

    backdrop-filter: blur(20px);

    box-shadow:
        0 30px 100px rgba(0,0,0,.8),
        0 0 50px rgba(255,30,50,.08);

    border-radius: 4px;

    animation: cardAppear 1s ease;
}

@keyframes cardAppear {
    from {
        opacity: 0;
        transform: translateY(30px) scale(.97);
    }

    to {
        opacity: 1;
        transform: translateY(0) scale(1);
    }
}

.brand-symbol {
    display: flex;
    justify-content: center;
    margin-bottom: 20px;
}

.mini-reactor {
    width: 58px;
    height: 58px;

    border-radius: 50%;

    background: radial-gradient(
        circle,
        white,
        var(--cyan) 30%,
        #0b6880 60%,
        transparent 65%
    );

    border: 2px solid var(--cyan);

    box-shadow:
        0 0 20px var(--cyan),
        0 0 50px rgba(85,234,255,.3);

    animation: reactorPulse 2s infinite;
}

.login-eyebrow,
.section-label {
    color: var(--gold);

    font-size: 10px;
    font-weight: bold;

    letter-spacing: 3px;
}

.login-eyebrow {
    text-align: center;
}

.login-title {
    text-align: center;

    font-size: 58px;
    letter-spacing: 8px;

    margin-top: 8px;

    font-weight: 900;

    text-shadow:
        0 0 20px rgba(255,255,255,.1);
}

.login-title span,
.page-title h2 span,
.hero-section h2 span {
    color: var(--red);
}

.login-tagline {
    text-align: center;

    font-size: 11px;
    letter-spacing: 5px;

    color: var(--muted);

    margin-top: 6px;
}

.login-divider {
    height: 1px;

    background:
        linear-gradient(
            90deg,
            transparent,
            var(--red),
            transparent
        );

    margin: 28px 0;
}

.login-card h2 {
    font-size: 15px;
    letter-spacing: 3px;
    margin-bottom: 22px;
}


/* =========================================
   INPUTS
   ========================================= */

.input-group {
    margin-bottom: 20px;
}

.input-group label {
    display: block;

    color: var(--muted);

    font-size: 10px;
    font-weight: bold;

    letter-spacing: 2px;

    margin-bottom: 8px;
}

input,
select,
textarea {
    width: 100%;

    padding: 14px 15px;

    color: var(--white);

    background: rgba(0,0,0,.45);

    border: 1px solid var(--border);

    outline: none;

    border-radius: 3px;

    font-family: inherit;

    transition: .25s;
}

input:focus,
select:focus,
textarea:focus {
    border-color: var(--red);

    box-shadow:
        0 0 0 2px rgba(255,38,56,.08),
        0 0 20px rgba(255,38,56,.08);
}

textarea {
    resize: vertical;
}

select option {
    background: #0a0d15;
}


/* =========================================
   BUTTONS
   ========================================= */

button {
    font-family: inherit;
    cursor: pointer;
}

.primary-button,
.secondary-button,
.back-button {
    border: none;

    padding: 14px 20px;

    font-size: 11px;
    font-weight: bold;

    letter-spacing: 1.5px;

    transition: .25s;
}

.primary-button {
    color: white;

    background:
        linear-gradient(
            90deg,
            #8d0712,
            var(--red)
        );

    box-shadow:
        0 0 20px rgba(255,38,56,.15);

    border: 1px solid rgba(255,80,90,.35);
}

.primary-button:hover {
    transform: translateY(-2px);

    box-shadow:
        0 8px 30px rgba(255,38,56,.25);
}

.secondary-button {
    color: var(--gold);

    background: rgba(255,211,78,.05);

    border: 1px solid rgba(255,211,78,.25);
}

.secondary-button:hover {
    background: rgba(255,211,78,.1);
    transform: translateY(-2px);
}

.login-button {
    width: 100%;

    display: flex;
    justify-content: space-between;
    align-items: center;

    margin-top: 5px;
}


/* =========================================
   LOGIN MESSAGE
   ========================================= */

.login-message {
    min-height: 20px;

    text-align: center;

    color: #ff6674;

    font-size: 12px;

    margin-top: 14px;
}

.login-message.success {
    color: var(--green);
}


/* =========================================
   DEMO CREDENTIALS
   ========================================= */

.demo-credentials {
    margin-top: 25px;

    padding-top: 18px;

    border-top: 1px solid rgba(255,255,255,.07);

    font-size: 10px;
    color: var(--muted);
}

.demo-credentials > p {
    color: var(--gold);
    letter-spacing: 2px;
    margin-bottom: 10px;
}

.demo-row {
    display: flex;
    justify-content: space-between;

    margin-bottom: 7px;
}

.demo-row span {
    color: #69748a;
}

.demo-row code {
    color: #d9e2f4;
}

.demo-credentials small {
    display: block;
    margin-top: 12px;
    line-height: 1.6;
}


/* =========================================
   APP TRANSITION
   ========================================= */

#app {
    opacity: 0;
    transform: translateX(50px);

    transition:
        opacity .7s ease,
        transform .8s cubic-bezier(.2,.8,.2,1);
}

#app.app-slide-in {
    opacity: 1;
    transform: translateX(0);
}


/* =========================================
   HEADER
   ========================================= */

.top-header {
    min-height: 82px;

    display: flex;
    justify-content: space-between;
    align-items: center;

    padding: 15px 5%;

    border-bottom: 1px solid rgba(255,255,255,.08);

    background: rgba(3,5,10,.88);

    backdrop-filter: blur(15px);

    position: sticky;
    top: 0;

    z-index: 100;
}

.header-brand {
    display: flex;
    align-items: center;
    gap: 14px;
}

.header-brand h1 {
    font-size: 22px;
    letter-spacing: 3px;
}

.header-brand h1 span {
    color: var(--red);
}

.header-brand p {
    color: var(--muted);
    font-size: 8px;
    letter-spacing: 2px;
    margin-top: 3px;
}

.header-reactor {
    width: 42px;
    height: 42px;

    border: 2px solid var(--cyan);
    border-radius: 50%;

    display: grid;
    place-items: center;

    box-shadow:
        0 0 15px rgba(85,234,255,.3);
}

.header-reactor div {
    width: 18px;
    height: 18px;

    border-radius: 50%;

    background: var(--cyan);

    box-shadow:
        0 0 15px var(--cyan);
}

.system-status {
    font-size: 9px;
    letter-spacing: 2px;

    color: var(--green);
}

.status-dot {
    display: inline-block;

    width: 7px;
    height: 7px;

    border-radius: 50%;

    background: var(--green);

    box-shadow: 0 0 10px var(--green);

    margin-right: 7px;

    animation: blink 1.5s infinite;
}

@keyframes blink {
    50% {
        opacity: .3;
    }
}


/* =========================================
   NAV
   ========================================= */

.main-nav {
    display: flex;
    justify-content: center;
    gap: 5px;

    padding: 12px 5%;

    border-bottom: 1px solid rgba(255,255,255,.06);

    background: rgba(5,7,13,.8);

    position: sticky;
    top: 82px;

    z-index: 90;

    backdrop-filter: blur(15px);
}

.main-nav button {
    padding: 10px 14px;

    border: 1px solid transparent;

    background: transparent;

    color: #8f9aae;

    font-size: 9px;
    font-weight: bold;

    letter-spacing: 1px;

    transition: .2s;
}

.main-nav button:hover {
    color: white;
    border-color: rgba(255,38,56,.3);
    background: rgba(255,38,56,.05);
}

.logout-button {
    color: #ff6975 !important;
}


/* =========================================
   MAIN
   ========================================= */

.main-container {
    width: min(1200px, 90%);

    margin: auto;

    padding: 60px 0;
}

.page-section {
    animation: pageIn .45s ease;
}

@keyframes pageIn {
    from {
        opacity: 0;
        transform: translateY(15px);
    }

    to {
        opacity: 1;
        transform: translateY(0);
    }
}


/* =========================================
   HERO
   ========================================= */

.hero-section {
    min-height: 390px;

    display: grid;
    grid-template-columns: 1.4fr .8fr;

    align-items: center;

    gap: 30px;

    padding: 50px;

    border: 1px solid rgba(255,255,255,.08);

    background:
        radial-gradient(
            circle at 85% 50%,
            rgba(255,38,56,.12),
            transparent 30%
        ),
        rgba(10,13,21,.72);

    position: relative;

    overflow: hidden;
}

.hero-section::before {
    content: "";

    position: absolute;

    width: 300px;
    height: 300px;

    right: -100px;
    top: -100px;

    border: 1px solid rgba(255,38,56,.2);

    border-radius: 50%;
}

.hero-section h2 {
    font-size: clamp(36px, 5vw, 62px);

    line-height: .95;

    margin: 12px 0 22px;

    letter-spacing: -2px;
}

.hero-description {
    color: var(--muted);

    max-width: 560px;

    line-height: 1.7;

    margin-bottom: 28px;
}

.hero-weapons {
    position: relative;

    height: 280px;
}

.floating-shield,
.floating-reactor,
.floating-hammer {
    position: absolute;
}

.small-shield {
    width: 130px;
    height: 130px;

    left: 25px;
    top: 70px;

    border-radius: 50%;

    display: grid;
    place-items: center;

    font-size: 40px;

    color: white;

    background:
        radial-gradient(
            circle,
            white 0 12%,
            var(--red) 13% 30%,
            white 31% 47%,
            #b5000c 48% 70%,
            white 71% 76%,
            #111 77%
        );

    box-shadow:
        0 0 35px rgba(255,38,56,.25);

    animation: shieldFloat 5s infinite ease-in-out;
}

.floating-hammer {
    right: 20px;
    top: 30px;

    font-size: 80px;

    filter:
        drop-shadow(0 0 15px rgba(120,190,255,.4));

    transform: rotate(-20deg);

    animation: hammerFloat 4s infinite ease-in-out;
}

.floating-reactor {
    right: 75px;
    bottom: 20px;

    width: 100px;
    height: 100px;

    border-radius: 50%;

    border: 3px solid var(--cyan);

    display: grid;
    place-items: center;

    box-shadow:
        0 0 30px rgba(85,234,255,.35);
}

.floating-reactor div {
    width: 42px;
    height: 42px;

    border-radius: 50%;

    background: var(--cyan);

    box-shadow: 0 0 30px var(--cyan);
}


/* =========================================
   STATS
   ========================================= */

.stats {
    display: grid;

    grid-template-columns: repeat(4, 1fr);

    gap: 15px;

    margin: 25px 0;
}

.stat-card {
    padding: 22px;

    background: var(--panel);

    border: 1px solid var(--border);

    position: relative;

    overflow: hidden;
}

.stat-card::after {
    content: "";

    position: absolute;

    bottom: 0;
    left: 0;

    width: 100%;
    height: 2px;

    background: linear-gradient(
        90deg,
        var(--red),
        var(--gold)
    );
}

.stat-icon {
    color: var(--gold);

    font-size: 20px;

    margin-bottom: 10px;
}

.stat-card h3 {
    font-size: 35px;
}

.stat-card p {
    color: var(--muted);

    font-size: 9px;

    letter-spacing: 2px;

    margin-top: 5px;
}


/* =========================================
   PANELS
   ========================================= */

.panel,
.form-panel,
.ai-panel {
    background: var(--panel);

    border: 1px solid var(--border);

    padding: 30px;
}

.panel-heading {
    display: flex;

    justify-content: space-between;
    align-items: center;

    gap: 20px;

    margin-bottom: 25px;
}

.panel-heading h2 {
    margin-top: 7px;

    font-size: 22px;

    letter-spacing: 1px;
}


/* =========================================
   PAGE TITLES
   ========================================= */

.page-title {
    margin-bottom: 30px;
}

.page-title h2 {
    font-size: clamp(35px, 5vw, 55px);

    margin: 10px 0;

    letter-spacing: -2px;
}

.page-title p:last-child {
    color: var(--muted);

    max-width: 650px;

    line-height: 1.6;
}


/* =========================================
   REPORT
   ========================================= */

.report-layout {
    display: grid;

    grid-template-columns: 1fr .85fr;

    gap: 20px;
}

.form-panel {
    display: flex;

    flex-direction: column;
}

.form-panel .primary-button,
.form-panel .secondary-button {
    margin-top: 10px;
}


/* =========================================
   AI PANEL
   ========================================= */

.ai-panel {
    min-height: 400px;

    background:
        radial-gradient(
            circle at 80% 10%,
            rgba(85,234,255,.08),
            transparent 30%
        ),
        var(--panel);
}

.ai-header {
    display: flex;

    align-items: center;

    gap: 15px;

    margin-bottom: 20px;
}

.ai-header h3 {
    margin-top: 5px;

    letter-spacing: 2px;
}

.ai-orb {
    width: 48px;
    height: 48px;

    border-radius: 50%;

    border: 2px solid var(--cyan);

    display: grid;
    place-items: center;

    box-shadow: 0 0 20px rgba(85,234,255,.3);
}

.ai-orb div {
    width: 17px;
    height: 17px;

    border-radius: 50%;

    background: var(--cyan);

    box-shadow: 0 0 20px var(--cyan);
}

.ai-status {
    padding: 10px;

    border: 1px solid rgba(85,234,255,.15);

    color: var(--cyan);

    font-size: 9px;

    letter-spacing: 2px;

    margin-bottom: 20px;
}

.ai-result > div {
    padding: 17px 0;

    border-bottom: 1px solid rgba(255,255,255,.06);
}

.ai-result span {
    display: block;

    color: var(--muted);

    font-size: 9px;

    letter-spacing: 2px;

    margin-bottom: 7px;
}

.ai-result strong {
    color: white;

    font-size: 14px;
}


/* =========================================
   TRACK
   ========================================= */

.track-box {
    display: flex;

    gap: 10px;

    max-width: 700px;

    margin-bottom: 25px;
}

.track-box input {
    flex: 1;
}

#trackResult {
    max-width: 850px;
}


/* =========================================
   TICKETS
   ========================================= */

.ticket-card {
    padding: 22px;

    margin-bottom: 12px;

    background:
        linear-gradient(
            100deg,
            rgba(255,255,255,.025),
            rgba(255,255,255,.01)
        );

    border: 1px solid rgba(255,255,255,.08);

    position: relative;

    transition: .25s;
}

.ticket-card:hover {
    border-color: rgba(255,38,56,.3);

    transform: translateX(3px);
}

.ticket-top {
    display: flex;

    justify-content: space-between;

    align-items: center;

    gap: 15px;

    margin-bottom: 15px;
}

.ticket-id {
    color: var(--gold);

    font-size: 12px;

    font-weight: bold;

    letter-spacing: 2px;
}

.ticket-title {
    font-size: 16px;

    margin-bottom: 8px;
}

.ticket-description {
    color: var(--muted);

    font-size: 13px;

    line-height: 1.6;

    margin-bottom: 15px;
}

.ticket-meta {
    display: flex;

    flex-wrap: wrap;

    gap: 8px;
}

.badge {
    display: inline-block;

    padding: 5px 8px;

    font-size: 8px;

    letter-spacing: 1px;

    border: 1px solid rgba(255,255,255,.12);
}

.priority-high {
    color: #ff5c6a;
    border-color: rgba(255,38,56,.3);
}

.priority-medium {
    color: var(--gold);
}

.priority-low {
    color: var(--green);
}

.status-pending {
    color: var(--gold);
}

.status-progress {
    color: var(--blue);
}

.status-resolved {
    color: var(--green);
}

.ticket-actions {
    display: flex;

    gap: 8px;

    margin-top: 18px;
}

.ticket-actions select {
    max-width: 180px;

    padding: 8px;

    font-size: 10px;
}


/* =========================================
   TIMELINE
   ========================================= */

.timeline {
    display: flex;

    align-items: center;

    gap: 0;

    margin-top: 20px;
}

.timeline-step {
    display: flex;

    align-items: center;

    flex: 1;
}

.timeline-dot {
    width: 13px;
    height: 13px;

    border-radius: 50%;

    border: 2px solid #586174;

    background: #0b0e15;

    flex-shrink: 0;
}

.timeline-step.active .timeline-dot {
    background: var(--red);

    border-color: var(--red);

    box-shadow: 0 0 12px rgba(255,38,56,.5);
}

.timeline-line {
    height: 2px;

    flex: 1;

    background: #303747;
}

.timeline-step.active .timeline-line {
    background: var(--red);
}

.timeline-label {
    color: var(--muted);

    font-size: 8px;

    margin-left: 7px;
}


/* =========================================
   FILTERS
   ========================================= */

.filter-panel {
    display: grid;

    grid-template-columns: repeat(3, 1fr);

    gap: 10px;

    margin-bottom: 15px;
}

.filter-panel select {
    font-size: 10px;
}


/* =========================================
   BACK BUTTON
   ========================================= */

.back-button {
    color: var(--muted);

    background: transparent;

    border: 1px solid rgba(255,255,255,.1);

    margin-bottom: 25px;
}

.back-button:hover {
    color: white;

    border-color: var(--red);
}


/* =========================================
   EMPTY
   ========================================= */

.empty-state {
    text-align: center;

    padding: 50px 20px;

    color: var(--muted);

    border: 1px dashed rgba(255,255,255,.08);

    font-size: 12px;
}


/* =========================================
   FOOTER
   ========================================= */

footer {
    display: flex;

    justify-content: center;
    align-items: center;

    gap: 15px;

    padding: 35px;

    border-top: 1px solid rgba(255,255,255,.07);

    color: #5e687c;

    font-size: 9px;

    letter-spacing: 2px;
}

.footer-reactor {
    width: 12px;
    height: 12px;

    border-radius: 50%;

    background: var(--cyan);

    box-shadow: 0 0 10px var(--cyan);
}


/* =========================================
   RESPONSIVE
   ========================================= */

@media (max-width: 900px) {

    .hero-section,
    .report-layout {
        grid-template-columns: 1fr;
    }

    .hero-weapons {
        display: none;
    }

    .stats {
        grid-template-columns: repeat(2, 1fr);
    }

    .shield-left,
    .shield-right,
    .thor-hammer,
    .reactor {
        opacity: .25;
        transform: scale(.7);
    }

    .main-nav {
        overflow-x: auto;
        justify-content: flex-start;
    }
}

@media (max-width: 600px) {

    .login-card {
        padding: 28px 20px;
    }

    .login-title {
        font-size: 42px;
    }

    .stats {
        grid-template-columns: 1fr 1fr;
    }

    .main-container {
        width: 94%;
        padding: 35px 0;
    }

    .hero-section {
        padding: 30px 22px;
    }

    .panel,
    .form-panel,
    .ai-panel {
        padding: 20px;
    }

    .filter-panel {
        grid-template-columns: 1fr;
    }

    .track-box {
        flex-direction: column;
    }

    .top-header {
        padding: 12px 3%;
    }

    .system-status {
        display: none;
    }

    footer {
        flex-direction: column;
    }
}
